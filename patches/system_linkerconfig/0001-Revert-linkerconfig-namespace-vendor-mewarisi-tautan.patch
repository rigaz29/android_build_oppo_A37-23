From 39612bc4f4b6e89a49bf186fbeb447b502e0585a Mon Sep 17 00:00:00 2001
From: rigaz29 <ryanbagas27@gmail.com>
Date: Sun, 23 Aug 2026 23:55:08 +0000
Subject: [PATCH 1/2] Revert "linkerconfig: namespace vendor mewarisi tautan
 APEX milik system"

This reverts commit 8a3c34c27e63d2cd191ddbb481d919414b620789.
---
 contents/namespace/vendordefault.cc | 31 +----------------------------
 1 file changed, 1 insertion(+), 30 deletions(-)

diff --git a/contents/namespace/vendordefault.cc b/contents/namespace/vendordefault.cc
index 8a7b656..27a5303 100644
--- a/contents/namespace/vendordefault.cc
+++ b/contents/namespace/vendordefault.cc
@@ -36,7 +36,7 @@ Namespace BuildVendorDefaultNamespace(const Context& ctx) {
   return BuildVendorNamespace(ctx, "default");
 }
 
-Namespace BuildVendorNamespace(const Context& ctx,
+Namespace BuildVendorNamespace([[maybe_unused]] const Context& ctx,
                                const std::string& name) {
   Namespace ns(name, /*is_isolated=*/true, /*is_visible=*/true);
 
@@ -64,35 +64,6 @@ Namespace BuildVendorNamespace(const Context& ctx,
   ns.AddPermittedPath("/system/vendor");
   ns.AddPermittedPath("/system");
 
-  // Search path di atas membuat pustaka /system/lib bisa DITEMUKAN, tapi itu
-  // belum cukup: sebagian di antaranya bergantung pada pustaka yang hanya ada
-  // di APEX, dan namespace vendor tidak punya tautan ke sana. Dua kegagalan
-  // nyata di perangkat, keduanya berujung pada APEX i18n:
-  //
-  //   mm-qcamera-daemon:
-  //     libandroid.so -> libharfbuzz_ng.so -> libicu.so         (tidak ketemu)
-  //   rild:
-  //     libril-qc-qmi-1.so -> libsqlite.so -> libandroidicu.so   (tidak ketemu)
-  //
-  // Namespace system sudah punya tautannya:
-  //   namespace.default.link.com_android_i18n.shared_libs =
-  //       libandroidicu.so:libicu.so:libicui18n.so:libicuuc.so
-  //
-  // Mewarisi require/provide yang sama membuat Section::Resolve membentuk
-  // tautan APEX itu untuk namespace vendor juga. Ini pola yang sudah dipakai
-  // BuildUnrestrictedDefaultNamespace dan BuildApexPlatformNamespace; keduanya
-  // memanggil pasangan fungsi yang persis sama. Keduanya ada di BaseContext
-  // sehingga nilainya tidak bergantung pada section yang sedang dibangun.
-  // HANYA AddRequires. AddProvides TIDAK boleh dipakai di sini: section vendor
-  // juga memuat BuildSystemNamespace (section/vendor.cc:43) yang sudah
-  // AddProvides(GetSystemProvideLibs()), dan Section::Resolve
-  // (modules/section.cc:82-88) memanggil LOG(FATAL) "duplicate: X is provided
-  // by A and B" bila dua namespace menyediakan pustaka yang sama. Itu akan
-  // membunuh linkerconfig dan membuat perangkat tidak punya ld.config sama
-  // sekali. BuildUnrestrictedDefaultNamespace boleh melakukannya karena section
-  // unrestricted TIDAK memuat namespace system.
-  ns.AddRequires(ctx.GetSystemRequireLibs());
-
   ns.GetLink("rs").AddSharedLib("libRS_internal.so");
   ns.AddRequires(base::Split(Var("LLNDK_LIBRARIES_VENDOR", ""), ":"));
 
-- 
2.43.0


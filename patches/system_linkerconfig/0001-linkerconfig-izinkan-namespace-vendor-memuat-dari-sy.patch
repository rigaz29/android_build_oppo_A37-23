From 8be2dfd485a24d35879e3a3b7544c2eed6f804b5 Mon Sep 17 00:00:00 2001
From: rigaz29 <ryanbagas27@gmail.com>
Date: Sun, 23 Aug 2026 12:49:48 +0000
Subject: [PATCH] linkerconfig: izinkan namespace vendor memuat dari /system
 (non-Treble)

mm-qcamera-daemon mati sebelum sempat jalan:

  library "/system/lib/libshim_camera.so" needed or dlopened by
  "/system/vendor/bin/mm-qcamera-daemon" is not accessible for the namespace:
  [name="(default)", permitted_paths="/odm:/vendor:/system/vendor"]

Akibat berantainya: tanpa daemon, get_number_of_cameras() mengembalikan -1,
CameraModule::init() memanggil mCameraInfoMap.setCapacity(0xFFFFFFFF), dan
VectorImpl::setCapacity gagal pada __builtin_mul_overflow -- cameraserver abort
59 kali.

A37 non-Treble: /vendor cuma direktori di dalam /system, HAL-nya passthrough,
dan tidak ada VNDK yang memisahkan keduanya. Blob vendornya memang menaut
pustaka platform, dan shim yang menjembataninya harus tinggal di /system karena
dependensinya tidak punya salinan vendor -- diperiksa di hasil build:
libsensor, liblog, libandroid, libstagefright, libmedia semuanya TIDAK ADA di
/system/vendor/lib.

Tiga jalan lain diperiksa dan buntu:
  1. PRODUCT_TREBLE_LINKER_NAMESPACES := false -- tidak bisa. build/make/core/
     config.mk:777-785 memakunya ke true dengan .KATI_READONLY, dan
     PRODUCT_TREBLE_LINKER_NAMESPACES_OVERRIDE dijadikan KATI_obsolete_var.
  2. permittedPaths di linker.config.pb -- hanya berlaku untuk namespace APEX,
     lihat modules/apex.cc:170.
  3. Bangun shim sebagai modul vendor -- gui/SensorManager.cpp membutuhkan
     libsensor, yang tidak ada di vendor; dependensinya berantai tanpa ujung.
     Itu juga alasan modul ini sengaja bukan LOCAL_VENDOR_MODULE sejak LOS 20.

Change-Id: I3d1a662ff9d6db16643b2a86baa94539f8b863af
---
 contents/namespace/vendordefault.cc | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/contents/namespace/vendordefault.cc b/contents/namespace/vendordefault.cc
index a866839..27a5303 100644
--- a/contents/namespace/vendordefault.cc
+++ b/contents/namespace/vendordefault.cc
@@ -45,9 +45,24 @@ Namespace BuildVendorNamespace([[maybe_unused]] const Context& ctx,
   ns.AddSearchPath("/vendor/${LIB}/hw");
   ns.AddSearchPath("/vendor/${LIB}/egl");
 
+  // Perangkat non-Treble: /vendor cuma direktori di dalam /system, HAL-nya
+  // passthrough, dan tidak ada VNDK yang memisahkan keduanya. Blob vendor di
+  // sini memang menaut pustaka platform, dan shim yang menjembataninya harus
+  // ikut tinggal di /system karena dependensinya (libsensor, libandroid,
+  // libstagefright, libmedia) tidak punya salinan vendor.
+  //
+  // Tanpa dua baris di bawah, mm-qcamera-daemon mati sebelum sempat jalan:
+  //   library "/system/lib/libshim_camera.so" ... is not accessible for the
+  //   namespace: [name="(default)", permitted_paths="/odm:/vendor:/system/vendor"]
+  // dan karena daemonnya tidak ada, get_number_of_cameras() mengembalikan -1
+  // sehingga CameraModule::init() memanggil setCapacity(0xFFFFFFFF) dan
+  // cameraserver abort berulang.
+  ns.AddSearchPath("/system/${LIB}");
+
   ns.AddPermittedPath("/odm");
   ns.AddPermittedPath("/vendor");
   ns.AddPermittedPath("/system/vendor");
+  ns.AddPermittedPath("/system");
 
   ns.GetLink("rs").AddSharedLib("libRS_internal.so");
   ns.AddRequires(base::Split(Var("LLNDK_LIBRARIES_VENDOR", ""), ":"));

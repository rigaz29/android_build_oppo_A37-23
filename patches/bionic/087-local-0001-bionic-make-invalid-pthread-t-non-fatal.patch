From c0727f785a7613bb1b646f5eac479c3a482b0c57 Mon Sep 17 00:00:00 2001
From: N7000 Patch Merge <n7000-patches@local.invalid>
Date: Mon, 27 Jul 2026 00:00:00 +0800
Subject: [PATCH] bionic: make invalid pthread_t non-fatal

Imported from lineage-diff-20260727 for the GT-N7000 LineageOS 23.2 tree.

---
diff --git a/libc/bionic/pthread_internal.cpp b/libc/bionic/pthread_internal.cpp
index 7c66c7531..e156bc00b 100644
--- a/libc/bionic/pthread_internal.cpp
+++ b/libc/bionic/pthread_internal.cpp
@@ -118,7 +118,7 @@ pthread_internal_t* __pthread_internal_find(pthread_t thread_id, const char* cal
       // TODO: try getting rid of this when Treble lets us keep vendor blobs on an old API level.
       async_safe_format_log(ANDROID_LOG_WARN, "libc", "invalid pthread_t (0) passed to %s", caller);
     } else {
-      async_safe_fatal("invalid pthread_t %p passed to %s", thread, caller);
+     async_safe_format_log(ANDROID_LOG_WARN, "libc", "invalid pthread_t (0) passed to %s", caller);
     }
   }
   return nullptr;

 }

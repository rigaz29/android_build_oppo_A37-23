From 4ce1e0f538c863de33272b869350f4c03555f590 Mon Sep 17 00:00:00 2001
From: rigaz29 <ryanbagas27@gmail.com>
Date: Thu, 27 Aug 2026 11:03:52 +0000
Subject: [PATCH] A37: pin libthermalclient lewat LD_PRELOAD agar destructor
 TLS tidak menggantung

Blob kamera msm8916 (QCameraThermalAdapter) melakukan dlopen lalu dlclose
sendiri terhadap libthermalclient.so. Pustaka itu mendaftarkan destructor key
TLS pada offset 0xcf8; setelah dlclose, key-nya tetap ada di tabel dengan
pointer destructor menunjuk memori yang sudah dilepas, dan thread berikutnya
yang keluar mati di pthread_key_clean_all().

Terukur di perangkat pada tiga crash berbeda: fault addr 0xe5d8ecf8, 0xda74ccf8,
dan 0xda60ecf8 -- ketiganya berakhir 0xcf8, offset yang sama di dalam pustaka.
Register r2 memuat alamat Thumb-nya (pc+1), yaitu pointer destructor yang
tersimpan di key. Pemicunya konsisten: potret dengan kamera belakang lalu pindah
ke kamera depan.

CameraWrapper sudah mem-pin pustaka ini dengan RTLD_NODELETE dan itu tidak
cukup: saat crash, libthermalclient yang terpin berada di 0xef3e9000 sedangkan
alamat yang menggantung 0xda60e000 -- instance lebih awal yang sudah dilepas
sebelum pin sempat berjalan. LD_PRELOAD memuatnya sebelum satu pun modul HAL
tersentuh, sehingga tidak pernah ada instance yang bisa dilepas.

Diverifikasi di perangkat: tiga siklus potret + pindah kamera + tutup
menghasilkan nol crash, nol pthread_key_clean_all, nol tombstone baru. Tanpa
perubahan ini crash terjadi pada setiap siklus.

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Change-Id: Ie999da3c7e62303454407f1d6ce05bae601669a9
---
 ...ardware.camera.provider-service.lineage.rc | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/camera/aidl/provider/android.hardware.camera.provider-service.lineage.rc b/camera/aidl/provider/android.hardware.camera.provider-service.lineage.rc
index e5fbce6..0fe7a3f 100644
--- a/camera/aidl/provider/android.hardware.camera.provider-service.lineage.rc
+++ b/camera/aidl/provider/android.hardware.camera.provider-service.lineage.rc
@@ -1,4 +1,25 @@
 service vendor.camera.provider /vendor/bin/hw/android.hardware.camera.provider-service.lineage
+    # A37: pin libthermalclient.so sebelum apa pun sempat memuatnya.
+    #
+    # Blob kamera msm8916 (QCameraThermalAdapter) melakukan dlopen lalu dlclose
+    # sendiri terhadap libthermalclient.so. Pustaka itu mendaftarkan destructor
+    # key TLS pada offset 0xcf8; begitu di-dlclose, key-nya tetap tinggal di
+    # tabel dengan pointer destructor menunjuk memori yang sudah dilepas, dan
+    # thread berikutnya yang keluar mati di pthread_key_clean_all().
+    #
+    # Terukur di perangkat: tiga crash berbeda, alamat fault 0xe5d8ecf8,
+    # 0xda74ccf8, dan 0xda60ecf8 -- ketiganya berakhir 0xcf8, offset yang sama.
+    # Pemicunya potret dengan kamera belakang lalu pindah ke kamera depan.
+    #
+    # CameraWrapper sudah mem-pin pustaka ini dengan RTLD_NODELETE, tetapi itu
+    # TIDAK cukup di sini: blob sempat memuat dan melepasnya lebih dulu di
+    # alamat lain, jadi yang terpin instance kedua sementara key dari instance
+    # pertama sudah menggantung. LD_PRELOAD memuatnya sebelum satu pun HAL
+    # tersentuh, sehingga tidak pernah ada instance yang bisa dilepas.
+    #
+    # Diverifikasi: tiga siklus potret + pindah kamera + tutup, nol crash, nol
+    # pthread_key_clean_all, nol tombstone. Tanpa ini crash terjadi tiap siklus.
+    setenv LD_PRELOAD /vendor/lib/libthermalclient.so
     interface aidl android.hardware.camera.provider.ICameraProvider/internal/0
     class hal
     user cameraserver
-- 

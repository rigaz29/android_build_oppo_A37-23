From 11f8348ed3d132dff3067618c3df89c6ec7a888c Mon Sep 17 00:00:00 2001
From: rigaz29 <ryanbagas27@gmail.com>
Date: Tue, 25 Aug 2026 12:51:28 +0000
Subject: [PATCH] A37: berhenti memanggil getLinkLayerStats yang HAL ini selalu
 tolak

HAL Wi-Fi legacy msm8916 menolak getLinkLayerStats dengan ERROR_INVALID_ARGS
(kode 7) dan penolakannya tidak akan pernah berubah. Penyebabnya terbaca di
lapisan bawah, berulang persis sebelum tiap kegagalan:

  E WifiHAL: get_wifi_interface_info:
             QCA_WLAN_VENDOR_ATTR_LL_STATS_IFACE_INFO_TS_DUTY_CYCLE not found

Atribut vendor QCA itu tidak pernah dipancarkan driver era 2016 ini.

Tanpa penjaga, setiap panggilan melakukan perjalanan binder, melempar
ServiceSpecificException, lalu mencatat error. Terukur di perangkat: 58
kegagalan dalam 33 menit, terus-menerus selama Wi-Fi menyala.

Berbeda dari getCachedScanData di berkas yang sama, kodenya BUKAN
ERROR_NOT_SUPPORTED yang menurut definisinya permanen, melainkan
ERROR_INVALID_ARGS yang bisa saja transien. Mematikan fitur pada kegagalan
pertama karena itu terlalu berani -- satu kegagalan sesaat akan menghapus
statistik link layer untuk seterusnya. Yang dipakai di sini adalah ambang lima
kegagalan BERTURUT-TURUT, dengan penghitung yang direset setiap kali panggilan
berhasil.

Cakupannya sengaja dibatasi satu sesi antarmuka: WifiStaIfaceAidlImpl dibuat
baru untuk tiap antarmuka STA (WifiStaIface.java:183) dan di-null saat
teardown, jadi mematikan-menyalakan Wi-Fi otomatis mencoba lagi dari awal.
Tidak ada keadaan yang perlu dibersihkan bila suatu saat driver atau HAL-nya
diperbaiki.

Lima kegagalan pertama tetap tercatat lengkap, jadi nilai diagnostiknya tidak
hilang -- hanya pengulangan tak berujungnya yang berhenti.

Diverifikasi di perangkat setelah APEX dipasang dan reboot:
  penjaga menyala   19:42:20, "failed 5 times in a row; disabling ..."
  sesudah itu       nol kegagalan selama 6 menit pemantauan
  Wi-Fi             IP 192.168.0.188, gateway 0% loss, 8.8.8.8 0% loss,
                    HTTP 204, framework menandai jaringan VALIDATED

Co-Authored-By: Claude Opus 5 <noreply@anthropic.com>
Change-Id: Idbda3a3b712f307c4e31f0ae0e859337a85ab931
---
 .../server/wifi/hal/WifiStaIfaceAidlImpl.java | 37 +++++++++++++++++++
 1 file changed, 37 insertions(+)

diff --git a/service/java/com/android/server/wifi/hal/WifiStaIfaceAidlImpl.java b/service/java/com/android/server/wifi/hal/WifiStaIfaceAidlImpl.java
index 4a6c0c3db6..621e75cd43 100644
--- a/service/java/com/android/server/wifi/hal/WifiStaIfaceAidlImpl.java
+++ b/service/java/com/android/server/wifi/hal/WifiStaIfaceAidlImpl.java
@@ -99,6 +99,32 @@ public class WifiStaIfaceAidlImpl implements IWifiStaIface {
     private final boolean mWifiLinkLayerAllRadiosStatsAggregationEnabled;
     private boolean mIsGetCachedScanDataSupported = true;
 
+    /**
+     * A37: HAL Wi-Fi legacy msm8916 menolak getLinkLayerStats secara PERMANEN.
+     *
+     * Penyebabnya terbaca di lapisan bawah, berulang persis sebelum tiap
+     * kegagalan: "get_wifi_interface_info:
+     * QCA_WLAN_VENDOR_ATTR_LL_STATS_IFACE_INFO_TS_DUTY_CYCLE not found".
+     * Atribut vendor QCA itu tidak pernah dipancarkan driver era 2016 ini,
+     * jadi penolakannya tidak akan pernah berubah.
+     *
+     * Berbeda dari getCachedScanData di atas, kodenya bukan ERROR_NOT_SUPPORTED
+     * melainkan ERROR_INVALID_ARGS (7), yang menurut definisinya BISA transien.
+     * Karena itu jangan dimatikan pada kegagalan pertama; hitung kegagalan
+     * berturut-turut dan berhenti hanya setelah jelas polanya. Penghitung
+     * direset setiap kali panggilan berhasil.
+     *
+     * Cakupannya aman: objek ini dibuat baru untuk tiap antarmuka STA
+     * (WifiStaIface.java:183), jadi mematikan-menyalakan Wi-Fi otomatis
+     * mencoba lagi dari awal.
+     *
+     * Terukur di perangkat sebelum penjaga ini: 58 kegagalan dalam 33 menit,
+     * masing-masing satu perjalanan binder plus pembangunan exception.
+     */
+    private static final int LINK_LAYER_STATS_FAILURE_LIMIT = 5;
+    private int mLinkLayerStatsFailures = 0;
+    private boolean mIsLinkLayerStatsSupported = true;
+
     public WifiStaIfaceAidlImpl(@NonNull android.hardware.wifi.IWifiStaIface staIface,
             @NonNull Context context, @NonNull SsidTranslator ssidTranslator) {
         mWifiStaIface = staIface;
@@ -426,13 +452,24 @@ public class WifiStaIfaceAidlImpl implements IWifiStaIface {
     public WifiLinkLayerStats getLinkLayerStats() {
         final String methodStr = "getLinkLayerStats";
         synchronized (mLock) {
+            // A37: sudah terbukti ditolak berulang kali oleh HAL ini.
+            if (!mIsLinkLayerStatsSupported) return null;
+
             try {
                 if (!checkIfaceAndLogFailure(methodStr)) return null;
                 StaLinkLayerStats halStats = mWifiStaIface.getLinkLayerStats();
+                // A37: berhasil -- polanya bukan kegagalan permanen.
+                mLinkLayerStatsFailures = 0;
                 return halToFrameworkLinkLayerStats(halStats);
             } catch (RemoteException e) {
                 handleRemoteException(e, methodStr);
             } catch (ServiceSpecificException e) {
+                // A37: hitung kegagalan berturut-turut, berhenti setelah jelas polanya.
+                if (++mLinkLayerStatsFailures >= LINK_LAYER_STATS_FAILURE_LIMIT) {
+                    mIsLinkLayerStatsSupported = false;
+                    Log.e(TAG, methodStr + " failed " + LINK_LAYER_STATS_FAILURE_LIMIT
+                            + " times in a row; disabling until the interface is set up again.");
+                }
                 handleServiceSpecificException(e, methodStr);
             } catch (IllegalArgumentException e) {
                 // May indicate a malformed return value in the HAL.
-- 
2.43.0

